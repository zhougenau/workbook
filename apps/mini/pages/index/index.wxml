<view class="page-shell">
  <view class="topbar">
    <view class="brand-mark">词</view>
    <view class="brand-copy">
      <text class="brand-name">词屿</text>
      <text class="brand-subtitle">本地优先的随身单词本</text>
    </view>
    <text class="entry-total">{{entries.length}} 词</text>
  </view>

  <button class="connection-toggle" bindtap="toggleConnectionDetails" aria-label="{{connectionExpanded ? '收起登录与同步信息' : '展开登录与同步信息'}}" aria-expanded="{{connectionExpanded}}">
    <view class="status-dot status-dot--{{syncStatus === 'error' ? 'error' : loginStatus}}"></view>
    <text class="connection-toggle-title">登录与同步</text>
    <text class="connection-toggle-status">{{syncStatus === 'error' ? '同步异常' : loginStatus === 'ok' ? '已连接' : '未连接'}}</text>
    <text class="connection-toggle-arrow {{connectionExpanded ? 'connection-toggle-arrow--open' : ''}}">⌄</text>
  </button>

  <view wx:if="{{connectionExpanded}}" class="connection-strip">
    <view class="connection-item">
      <view class="status-dot status-dot--{{healthStatus}}"></view>
      <view class="connection-copy">
        <text class="connection-title">Supabase</text>
        <text class="connection-detail">{{healthMessage}}</text>
      </view>
      <button class="text-button" bindtap="testConnection" loading="{{healthStatus === 'checking'}}">检测</button>
    </view>
    <view class="connection-item">
      <view class="status-dot status-dot--{{loginStatus}}"></view>
      <view class="connection-copy">
        <text class="connection-title">微信身份</text>
        <text class="connection-detail">{{loginMessage}}</text>
      </view>
      <button class="text-button" bindtap="login" loading="{{loginStatus === 'checking'}}">连接</button>
    </view>
    <view class="connection-item">
      <view class="status-dot status-dot--{{syncStatus}}"></view>
      <view class="connection-copy">
        <text class="connection-title">云端词库</text>
        <text class="connection-detail">{{syncMessage}}</text>
      </view>
      <button class="text-button" bindtap="synchronize" loading="{{syncStatus === 'checking'}}">同步</button>
    </view>
  </view>

  <view wx:if="{{connectionExpanded && loginStatus === 'ok'}}" class="account-link-section">
    <view class="account-link-heading">
      <view class="status-dot status-dot--{{linkStatus}}"></view>
      <view>
        <text class="connection-title">绑定 Web 词屿</text>
        <text class="connection-detail">{{linkMessage}}</text>
      </view>
    </view>
    <view class="account-link-form">
      <input
        value="{{linkCode}}"
        bindinput="handleLinkCode"
        maxlength="9"
        placeholder="XXXX-XXXX"
        aria-label="Web 一次性绑定码"
      />
      <button bindtap="bindWebAccount" loading="{{linkStatus === 'checking'}}">绑定并合并</button>
    </view>
  </view>

  <view class="daily-review">
    <view class="daily-review-heading">
      <text>今日待复习 {{dueReviewCount}}</text>
      <button bindtap="startDailyReview" disabled="{{!dueReviewCount}}">开始复习</button>
    </view>
    <view class="due-card-groups" aria-label="到期卡片分组">
      <button wx:for="{{dueCardGroups}}" wx:key="key" data-group="{{item.key}}" bindtap="startDueCards" disabled="{{!item.count}}" aria-label="{{item.label}}，{{item.count}} 个待复习">
        <text class="due-card-icon" aria-hidden="true">{{item.icon}}</text>
        <text class="due-card-label">{{item.shortLabel}}</text>
        <text class="due-card-count" aria-hidden="true">{{item.count}}</text>
      </button>
    </view>
    <view wx:if="{{dailyWord}}" class="daily-review-session">
      <text>{{dailyCardMode ? '到期卡片' : '今日复习'}} · 本轮剩余 {{dailyWordIds.length}} 词{{dailyCardMode && dailyOverdueDays ? ' · 逾期 ' + dailyOverdueDays + ' 天' : ''}}{{dailyCardLoading ? ' · 正在准备卡片' : ''}}</text>
      <text class="daily-review-term">{{dailyWord.term}}</text>
      <view wx:if="{{!dailyRevealed}}" class="daily-review-preview-actions">
        <button bindtap="revealDailyWord">揭晓答案</button>
        <button class="daily-review-exit" bindtap="closeDailyReview">退出</button>
      </view>
      <view wx:else>
        <text class="daily-review-meaning">{{dailyWord.meaning || (dailyCardMode && dailyCard && dailyCard.meaning) || '暂无释义'}}</text>
        <text wx:if="{{dailyWord.note}}" class="daily-review-meaning">{{dailyWord.note}}</text>
        <view wx:if="{{dailyCardMode && dailyCard}}" class="due-card-detail">
          <text>{{dailyCard.usage}}</text>
          <text>{{dailyCard.memoryTip}}</text>
        </view>
        <view class="daily-review-actions">
          <button data-remembered="false" bindtap="rateDailyWord">没记住</button>
          <button data-remembered="true" bindtap="rateDailyWord">记住了</button>
          <button class="daily-review-exit" bindtap="closeDailyReview">退出</button>
        </view>
      </view>
      <text wx:if="{{dailyCardMessage}}" class="daily-card-message">{{dailyCardMessage}}</text>
    </view>
  </view>

  <view class="capture-section">
    <view class="section-heading section-heading--capture">
      <text class="section-index">01</text>
      <view>
        <text class="section-title">记下新单词</text>
        <text class="section-note">先落笔，再慢慢理解。</text>
      </view>
      <button class="section-toggle" bindtap="toggleCapture" aria-label="{{captureExpanded ? '收起记下新单词' : '展开记下新单词'}}" aria-expanded="{{captureExpanded}}">
        <text class="section-toggle-arrow {{captureExpanded ? 'section-toggle-arrow--open' : ''}}">⌄</text>
      </button>
    </view>

    <view wx:if="{{captureExpanded}}" class="capture-content">
    <view class="analyzer">
      <view class="field-heading">
        <text>智能选取</text>
        <text class="field-hint">粘贴单词、释义和例句</text>
      </view>
      <textarea
        class="analysis-input"
        value="{{analysisSource}}"
        data-field="analysisSource"
        bindinput="handleFieldInput"
        placeholder="convivial adj.&#10;欢乐友好的&#10;The dinner had a convivial atmosphere."
        maxlength="3000"
      ></textarea>
      <button class="analyze-button" bindtap="analyzeText" disabled="{{!analysisSource}}">智能分析</button>
    </view>

    <view class="form-grid">
      <label class="field field--term">
        <text>单词或短语</text>
        <input value="{{term}}" data-field="term" bindinput="handleFieldInput" placeholder="serendipity" maxlength="200" />
      </label>
      <text wx:if="{{completionStatus !== 'idle'}}" class="completion-status {{completionStatus === 'error' ? 'completion-status--error' : ''}}">{{completionStatus === 'loading' ? 'AI 正在补全…' : completionStatus === 'done' ? 'AI 已补全' : 'AI 补全暂不可用，可手动填写'}}</text>
      <label class="field">
        <text>中文释义</text>
        <input value="{{meaning}}" data-field="meaning" bindinput="handleFieldInput" placeholder="意外发现美好事物" maxlength="500" />
      </label>
      <label class="field field--note">
        <text>例句或笔记</text>
        <input value="{{note}}" data-field="note" bindinput="handleFieldInput" placeholder="在哪里遇见它？" maxlength="1000" />
      </label>
      <button class="primary-button" bindtap="addEntry" disabled="{{completionStatus === 'loading'}}">＋ 收录单词</button>
    </view>
    <view wx:if="{{message}}" class="message">{{message}}</view>
    </view>
  </view>

  <view id="ai-review-section" class="ai-section">
    <view class="section-heading section-heading--library">
      <text class="section-index">02</text>
      <view>
        <text class="section-title">AI 学习工坊</text>
        <text class="section-note">已选择 {{aiSelectedIds.length}} 个单词，单次最多 10 个。</text>
      </view>
      <button class="section-toggle" bindtap="toggleAiWorkshop" aria-label="{{aiWorkshopExpanded ? '收起 AI 学习工坊' : '展开 AI 学习工坊'}}" aria-expanded="{{aiWorkshopExpanded}}">
        <text class="section-toggle-arrow {{aiWorkshopExpanded ? 'section-toggle-arrow--open' : ''}}">⌄</text>
      </button>
    </view>

    <button wx:if="{{!aiWorkshopExpanded}}" class="collapsed-flashcards" bindtap="createRandomFlashcards" disabled="{{!entries.length || aiStatus === 'checking'}}">随机卡片</button>

    <view wx:if="{{aiWorkshopExpanded}}" class="ai-workshop-content">
    <view class="paid-usage" aria-label="AI 用量">
      <view class="paid-usage-heading">
        <text>AI 用量</text>
        <button wx:if="{{loginStatus === 'ok'}}" bindtap="refreshPaidUsage" disabled="{{paidUsageStatus === 'loading'}}" aria-label="刷新 AI 用量">↻</button>
      </view>
      <view wx:if="{{paidUsage && paidUsageStatus !== 'error'}}" class="paid-usage-values">
        <text>文本实际 {{paidUsage.text.used}} · 累计预留 {{paidUsage.text.reserved}} / {{paidUsage.text.limit}} tokens</text>
        <text>语音实际 {{paidUsage.speech.used}} · 累计预留 {{paidUsage.speech.reserved}} / {{paidUsage.speech.limit}} 字</text>
        <text>近 1 分钟 文本 {{paidUsage.requests.used}}/{{paidUsage.requests.limit}} · 语音 {{paidUsage.speechRequests.used}}/{{paidUsage.speechRequests.limit}} 次</text>
        <text>并发 {{paidUsage.concurrent.used}}/{{paidUsage.concurrent.limit}}</text>
        <text class="paid-usage-day">{{paidUsage.day}} UTC</text>
      </view>
      <text wx:else class="paid-usage-message">{{paidUsageStatus === 'error' ? '读取失败，请刷新重试' : loginStatus === 'ok' ? '正在读取…' : '连接微信身份后查看'}}</text>
    </view>
    <view class="ai-toolbar">
      <view class="ai-word-picker">
        <text class="ai-picker-label">{{entries.length ? '本次学习词汇' : '请先在下方收录单词'}}</text>
        <text class="ai-picker-count">已选 {{aiSelectedIds.length}} / 10</text>
      </view>
      <view class="ai-control-row">
        <text>AI 接入商</text>
        <picker mode="selector" range="{{aiProviders}}" range-key="label" value="{{aiProviderIndex}}" bindchange="chooseAiProvider" aria-label="AI 接入商">
          <view class="ai-provider-picker">{{aiProviders[aiProviderIndex].label}} <text>⌄</text></view>
        </picker>
      </view>
      <view class="ai-control-row">
        <text>短文长度</text>
        <view class="segmented-control">
          <button class="{{aiLength === 'short' ? 'active' : ''}}" data-length="short" bindtap="chooseAiLength">短</button>
          <button class="{{aiLength === 'medium' ? 'active' : ''}}" data-length="medium" bindtap="chooseAiLength">中</button>
          <button class="{{aiLength === 'long' ? 'active' : ''}}" data-length="long" bindtap="chooseAiLength">长</button>
        </view>
      </view>
      <view class="ai-control-row">
        <text>复习难度</text>
        <view class="segmented-control segmented-control--wide">
          <button class="{{aiDifficulty === 'basic' ? 'active' : ''}}" data-difficulty="basic" bindtap="chooseAiDifficulty">基础</button>
          <button class="{{aiDifficulty === 'intermediate' ? 'active' : ''}}" data-difficulty="intermediate" bindtap="chooseAiDifficulty">进阶</button>
          <button class="{{aiDifficulty === 'advanced' ? 'active' : ''}}" data-difficulty="advanced" bindtap="chooseAiDifficulty">挑战</button>
        </view>
      </view>
      <view class="ai-control-row">
        <text>练习方式</text>
        <view class="segmented-control segmented-control--wide">
          <button class="{{aiReviewMode === 'standard' ? 'active' : ''}}" data-mode="standard" bindtap="chooseAiReviewMode">综合复习</button>
          <button class="{{aiReviewMode === 'context' ? 'active' : ''}}" data-mode="context" bindtap="chooseAiReviewMode">真实语境</button>
        </view>
      </view>
      <view class="ai-control-row">
        <text>随机卡片数量</text>
        <view class="segmented-control">
          <button class="{{randomFlashcardCount === 10 ? 'active' : ''}}" data-count="10" bindtap="chooseRandomFlashcardCount">10</button>
          <button class="{{randomFlashcardCount === 20 ? 'active' : ''}}" data-count="20" bindtap="chooseRandomFlashcardCount">20</button>
          <button class="{{randomFlashcardCount === 50 ? 'active' : ''}}" data-count="50" bindtap="chooseRandomFlashcardCount">50</button>
        </view>
      </view>
      <view class="ai-actions">
        <button class="ai-action--passage" bindtap="createPassage" loading="{{aiStatus === 'checking'}}" disabled="{{!aiSelectedIds.length || aiStatus === 'checking'}}">生成短文</button>
        <button class="ai-action--review" bindtap="createReview" loading="{{aiStatus === 'checking'}}" disabled="{{!aiSelectedIds.length || aiStatus === 'checking'}}">生成复习题</button>
        <button class="ai-action--flashcard" bindtap="createFlashcards" loading="{{aiStatus === 'checking'}}" disabled="{{!entries.length || aiStatus === 'checking'}}">{{aiSelectedIds.length ? '生成卡片' : '随机卡片'}}</button>
      </view>
      <text class="ai-message ai-message--{{aiStatus}}">{{aiMessage}}</text>
    </view>

    <view wx:if="{{passage}}" class="passage-result">
      <text class="result-kicker">AI READING · {{passage.tokenUsage.totalTokens}} TOKENS</text>
      <text class="passage-title">{{passage.title}}</text>
      <text class="passage-copy" user-select>{{passage.passage}}</text>
      <view class="passage-translation">
        <text>参考译文</text>
        <text user-select>{{passage.translation}}</text>
      </view>
      <view class="used-words">
        <text wx:for="{{passage.usedWords}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view wx:if="{{flashcards && currentFlashcard}}" class="flashcard-result">
      <view class="flashcard-result-heading">
        <view>
          <text class="result-kicker">AI FLASHCARDS</text>
          <text class="flashcard-progress">{{flashcardIndex + 1}} / {{flashcards.cards.length}}</text>
        </view>
        <view class="flashcard-heading-actions">
          <picker mode="selector" range="{{speechRateLabels}}" value="{{speechRateIndex}}" bindchange="handleSpeechRateChange" aria-label="朗读语速">
            <view class="speech-rate-picker speech-rate-picker--dark">语速 {{speechRateLabels[speechRateIndex]}} <text>⌄</text></view>
          </picker>
          <button class="flashcard-playback {{flashcardAutoplay ? 'active' : ''}}" bindtap="toggleFlashcardAutoplay" aria-label="{{flashcardAutoplay ? '暂停自动播放' : '自动播放卡片'}}" title="{{flashcardAutoplay ? '暂停自动播放' : '自动播放卡片'}}">
            <view class="flashcard-playback-icon" />
          </button>
          <button class="flashcard-close" bindtap="closeFlashcards" aria-label="退出卡片学习">×</button>
        </view>
      </view>

      <view class="flashcard-sheet" bindtouchstart="startFlashcardSwipe" bindtouchend="endFlashcardSwipe" bindtouchcancel="cancelFlashcardSwipe">
        <view class="flashcard-word-row">
          <text class="flashcard-word">{{currentFlashcard.word}}</text>
          <button
            class="flashcard-speech {{speechSource === 'flashcard' && speechStatus === 'playing' ? 'active' : ''}}"
            bindtap="tapFlashcardSpeech"
            loading="{{speechSource === 'flashcard' && speechStatus === 'loading'}}"
            aria-label="{{speechSource === 'flashcard' && speechStatus === 'playing' ? '停止发音' : '朗读单词和例句'}}"
          >{{speechSource === 'flashcard' && speechStatus === 'playing' ? '停止' : speechSource === 'flashcard' && speechStatus === 'loading' ? '加载中' : '发音'}}</button>
        </view>
        <view class="flashcard-field">
          <text>释义</text>
          <text>{{currentFlashcard.meaning}}</text>
        </view>
        <view class="flashcard-field">
          <text>用法</text>
          <text user-select>{{currentFlashcard.usage}}</text>
        </view>
        <view class="flashcard-supplement">
          <view>
            <text>同义词</text>
            <view class="flashcard-tags">
              <block wx:if="{{currentFlashcard.synonyms.length}}">
                <text wx:for="{{currentFlashcard.synonyms}}" wx:key="*this">{{item}}</text>
              </block>
              <text wx:else class="flashcard-empty-tag">暂无常用同义词</text>
            </view>
          </view>
          <view>
            <text>反义词</text>
            <view class="flashcard-tags">
              <block wx:if="{{currentFlashcard.antonyms.length}}">
                <text wx:for="{{currentFlashcard.antonyms}}" wx:key="*this">{{item}}</text>
              </block>
              <text wx:else class="flashcard-empty-tag">暂无常用反义词</text>
            </view>
          </view>
          <view class="flashcard-memory">
            <text>记忆方法</text>
            <text>{{currentFlashcard.memoryTip}}</text>
          </view>
        </view>
      </view>

      <view class="flashcard-dots">
        <button
          wx:for="{{flashcards.cards}}"
          wx:key="wordId"
          class="{{index === flashcardIndex ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="selectFlashcard"
          aria-label="查看第 {{index + 1}} 张：{{item.word}}"
        />
      </view>
      <view class="flashcard-navigation">
        <button data-direction="previous" bindtap="navigateFlashcard" disabled="{{flashcardIndex === 0}}">‹ 上一张</button>
        <button wx:if="{{flashcardIndex + 1 === flashcards.cards.length}}" class="flashcard-test" bindtap="startFlashcardReview">开始 AI 测试</button>
        <button wx:else data-direction="next" bindtap="navigateFlashcard">下一张 ›</button>
      </view>
      <view class="flashcard-token-usage">
        <text>输入 {{flashcards.tokenUsage.promptTokens}}</text>
        <text>输出 {{flashcards.tokenUsage.completionTokens}}</text>
        <text>总计 {{flashcards.tokenUsage.totalTokens}}</text>
      </view>
    </view>

    <view wx:if="{{quiz}}" id="ai-review-result" class="quiz-result">
      <view class="quiz-heading">
        <view>
          <text class="result-kicker">AI REVIEW · {{quiz.tokenUsage.totalTokens}} TOKENS</text>
          <text class="quiz-title">{{quiz.title}}</text>
        </view>
        <text wx:if="{{quizComplete}}">{{quizCorrectCount}} / {{quiz.questions.length}}</text>
        <text wx:else>{{quizCurrentIndex + 1}} / {{quiz.questions.length}}</text>
      </view>
      <view wx:if="{{currentQuestion}}" class="quiz-question">
        <text class="question-index">QUESTION {{quizCurrentIndex + 1}} · {{currentQuestion.typeLabel}}</text>
        <text class="question-prompt">{{currentQuestion.prompt}}</text>
        <view class="quiz-options">
          <button
            wx:for="{{currentQuestion.optionItems}}"
            wx:key="optionIndex"
            wx:for-item="option"
            class="quiz-option quiz-option--{{option.state}}"
            data-option="{{option.optionIndex}}"
            bindtap="answerReview"
            disabled="{{currentQuestion.answered}}"
          >{{option.text}}</button>
        </view>
        <view wx:if="{{currentQuestion.answered}}" class="question-feedback question-feedback--{{currentQuestion.answerCorrect ? 'correct' : 'wrong'}}">
          <text>{{currentQuestion.feedbackTitle}}</text>
          <text>{{currentQuestion.explanation}}</text>
        </view>
        <button wx:if="{{currentQuestion.answered}}" class="quiz-next" bindtap="nextReviewQuestion">{{quizCurrentIndex + 1 === quiz.questions.length ? '查看成绩' : '下一题 →'}}</button>
      </view>
      <view wx:if="{{quizComplete}}" class="quiz-complete">
        <text>本轮复习完成</text>
        <text class="quiz-score">{{quizCorrectCount}} / {{quiz.questions.length}}</text>
        <text>{{masteryMessage}}</text>
        <view class="mastery-review">
          <view class="mastery-review-heading">
            <text>熟练度变化</text>
            <text>每轮自动调整最多 1 级</text>
          </view>
          <view wx:for="{{masteryChanges}}" wx:key="wordId" class="mastery-change">
            <view>
              <text>{{item.term}}</text>
              <text>{{item.correctCount}}/{{item.questionCount}} 题正确 · 证据 {{item.evidenceLabel}}</text>
            </view>
            <text class="mastery-level mastery-level--{{item.direction}}">{{item.previousLevel}} → {{item.nextLevel}}</text>
          </view>
        </view>
        <text class="quiz-restart-hint">重新点击“生成复习题”可开始新一轮。</text>
      </view>
    </view>
    </view>
  </view>

  <view class="library-section">
    <view class="section-heading section-heading--library">
      <text class="section-index">03</text>
      <view>
        <text class="section-title">我的词库</text>
        <text class="section-note">选择单词用于 AI 学习，熟练度从 0 到 5 逐步积累。</text>
      </view>
      <view wx:if="{{selectionMode}}" class="selection-actions">
        <button class="selection-done selection-all" bindtap="selectVisibleWords" disabled="{{!visibleEntries.length}}" aria-label="{{pageSelectionComplete ? '取消全部已选单词' : '本页全选，单次最多 10 个单词'}}">{{pageSelectionComplete ? '取消全选' : '本页全选'}}</button>
        <button class="selection-done" bindtap="finishWordSelection" aria-label="完成选择并保留所选单词">完成</button>
      </view>
    </view>

    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input value="{{search}}" bindinput="handleSearch" placeholder="搜索单词、释义或笔记" />
    </view>

    <view class="library-filter-row">
      <picker mode="selector" range="{{masteryFilterLabels}}" value="{{masteryFilterIndex}}" bindchange="handleMasteryFilterChange" aria-label="按掌握度筛选">
        <view class="library-filter-picker">{{masteryFilterLabels[masteryFilterIndex]}} <text>⌄</text></view>
      </picker>
      <picker mode="selector" range="{{sortLabels}}" value="{{sortIndex}}" bindchange="handleSortChange" aria-label="排序方式">
        <view class="library-filter-picker">{{sortLabels[sortIndex]}} <text>⌄</text></view>
      </picker>
      <picker mode="selector" range="{{pageSizeOptions}}" value="{{pageSizeIndex}}" bindchange="handlePageSizeChange" aria-label="每页显示数量">
        <view class="library-filter-picker">每页 {{pageSize}} 个 <text>⌄</text></view>
      </picker>
      <picker mode="selector" range="{{speechRateLabels}}" value="{{speechRateIndex}}" bindchange="handleSpeechRateChange" aria-label="朗读语速">
        <view class="speech-rate-picker">语速 {{speechRateLabels[speechRateIndex]}} <text>⌄</text></view>
      </picker>
    </view>

    <view wx:if="{{filteredEntryCount}}" class="pagination pagination--top">
      <view class="pagination-summary">
        <text>第 <text class="pagination-strong">{{currentPage}}</text> / {{totalPages}} 页</text>
        <text>显示 {{pageFirstItem}}–{{pageLastItem}}，共 {{filteredEntryCount}} 个</text>
      </view>
      <view class="pagination-buttons">
        <button class="pagination-button" data-action="first" bindtap="handlePageChange" disabled="{{currentPage === 1}}" aria-label="最前页">«</button>
        <button class="pagination-button" data-action="previous" bindtap="handlePageChange" disabled="{{currentPage === 1}}" aria-label="上一页">‹</button>
        <button class="pagination-button" data-action="next" bindtap="handlePageChange" disabled="{{currentPage === totalPages}}" aria-label="下一页">›</button>
        <button class="pagination-button" data-action="last" bindtap="handlePageChange" disabled="{{currentPage === totalPages}}" aria-label="最后页">»</button>
      </view>
    </view>

    <view wx:if="{{visibleEntries.length}}" class="word-list">
      <view wx:for="{{visibleEntries}}" wx:key="id" class="word-row {{item.aiSelected ? 'word-row--selected' : ''}}" data-id="{{item.id}}" bindlongpress="beginWordSelection" aria-label="{{item.term}}，长按选择用于 AI 学习">
        <checkbox
          wx:if="{{selectionMode}}"
          class="ai-word-checkbox"
          checked="{{item.aiSelected}}"
          color="#315b47"
          data-id="{{item.id}}"
          bindtap="toggleAiWord"
          catchlongpress="preventWordSelection"
          aria-label="选择 {{item.term}} 用于 AI 学习"
        />
        <view class="word-main">
          <view class="word-term-row">
            <text class="word-term">{{item.term}}</text>
            <view class="word-tools" catchlongpress="preventWordSelection">
              <button
                class="word-speech-button {{speechSource === 'word' && speechWordId === item.id && speechStatus === 'playing' ? 'active' : ''}}"
                data-id="{{item.id}}"
                bindtap="speakWord"
                catchlongpress="preventWordSelection"
                loading="{{speechSource === 'word' && speechWordId === item.id && speechStatus === 'loading'}}"
                aria-label="{{speechSource === 'word' && speechWordId === item.id && speechStatus === 'playing' ? '停止朗读 ' + item.term : '朗读 ' + item.term + ' 和例句'}}"
              >{{speechSource === 'word' && speechWordId === item.id && speechStatus === 'playing' ? '■' : '🔊'}}</button>
              <button class="word-edit-button" data-id="{{item.id}}" bindtap="editEntry" aria-label="编辑 {{item.term}}">✎</button>
              <button class="word-chat-button" data-id="{{item.id}}" bindtap="openWordChat" aria-label="和 AI 学习 {{item.term}}">💬</button>
              <button class="word-test-button" data-id="{{item.id}}" bindtap="startSingleWordReview" disabled="{{selectionMode || aiStatus === 'checking'}}" aria-label="用 {{item.term}} 进行 5 道基础 AI 测试">?</button>
              <button class="delete-button" data-id="{{item.id}}" bindtap="deleteEntry" aria-label="删除 {{item.term}}">×</button>
            </view>
          </view>
          <text class="word-meaning">{{item.meaning || '尚未填写释义'}}</text>
          <text wx:if="{{item.note}}" class="word-note">{{item.note}}</text>
        </view>
        <text class="mastery-number" aria-label="熟练度 {{item.mastery}}，满级 5">{{item.mastery}}</text>
      </view>
    </view>

    <view wx:if="{{filteredEntryCount}}" class="pagination pagination--bottom">
      <view class="pagination-summary">
        <text>第 <text class="pagination-strong">{{currentPage}}</text> / {{totalPages}} 页</text>
        <text>显示 {{pageFirstItem}}–{{pageLastItem}}，共 {{filteredEntryCount}} 个</text>
      </view>
      <view class="pagination-buttons">
        <button class="pagination-button" data-action="first" bindtap="handlePageChange" disabled="{{currentPage === 1}}" aria-label="最前页">«</button>
        <button class="pagination-button" data-action="previous" bindtap="handlePageChange" disabled="{{currentPage === 1}}" aria-label="上一页">‹</button>
        <button class="pagination-button" data-action="next" bindtap="handlePageChange" disabled="{{currentPage === totalPages}}" aria-label="下一页">›</button>
        <button class="pagination-button" data-action="last" bindtap="handlePageChange" disabled="{{currentPage === totalPages}}" aria-label="最后页">»</button>
      </view>
    </view>

    <view wx:if="{{!filteredEntryCount}}" class="empty-state">
      <text class="empty-symbol">Aa</text>
      <text class="empty-title">{{search ? '没有匹配的单词' : '词库还是空的'}}</text>
      <text>{{search ? '换一个关键词试试。' : '从今天遇见的第一个词开始。'}}</text>
    </view>
  </view>
  <view class="app-meta" aria-label="版本信息">
    <text>版本 v{{appVersion}}</text>
    <text>最后更新 {{appUpdatedAt}}</text>
  </view>
</view>

<view wx:if="{{editingId}}" class="word-chat-overlay">
  <view class="word-chat-mask" bindtap="cancelEdit"></view>
  <view class="word-edit-panel" role="dialog" aria-label="编辑词条">
    <view class="word-edit-heading">
      <text>编辑词条</text>
      <button bindtap="cancelEdit" aria-label="取消编辑">×</button>
    </view>
    <label class="word-edit-field">
      <text>单词或短语</text>
      <input value="{{editTerm}}" data-field="editTerm" bindinput="handleEditInput" maxlength="200" placeholder="单词或短语" />
    </label>
    <label class="word-edit-field">
      <text>中文释义</text>
      <input value="{{editMeaning}}" data-field="editMeaning" bindinput="handleEditInput" maxlength="500" placeholder="补充释义" />
    </label>
    <label class="word-edit-field">
      <text>例句或笔记</text>
      <textarea value="{{editNote}}" data-field="editNote" bindinput="handleEditInput" maxlength="1000" placeholder="补充笔记或例句" auto-height="false"></textarea>
    </label>
    <view class="word-edit-mastery">
      <text>熟练度</text>
      <view class="word-edit-stepper">
        <button data-delta="-1" bindtap="adjustEditMastery" disabled="{{editMastery === 0}}" aria-label="降低熟练度">−</button>
        <text aria-label="当前熟练度 {{editMastery}}，满级 5">{{editMastery}}</text>
        <button data-delta="1" bindtap="adjustEditMastery" disabled="{{editMastery === 5}}" aria-label="提高熟练度">＋</button>
      </view>
    </view>
    <text wx:if="{{editError}}" class="word-edit-error">{{editError}}</text>
    <view class="word-edit-actions">
      <button bindtap="cancelEdit">取消</button>
      <button bindtap="saveEdit" disabled="{{!editTerm}}">完成</button>
    </view>
  </view>
</view>

<view wx:if="{{chatWord}}" class="word-chat-overlay">
  <view class="word-chat-mask" bindtap="closeWordChat"></view>
  <view class="word-chat-panel" role="dialog" aria-label="和 AI 学习 {{chatWord.term}}">
    <view class="word-chat-heading">
      <view class="word-chat-title-group">
        <text class="word-chat-kicker">AI WORD COACH · {{aiProviders[aiProviderIndex].label}}</text>
        <text class="word-chat-title">{{chatWord.term}}</text>
        <text class="word-chat-meaning">{{chatWord.meaning || '围绕这个单词提问'}}</text>
      </view>
      <button class="word-chat-close" bindtap="closeWordChat" aria-label="关闭 AI 对话">×</button>
    </view>
    <scroll-view class="word-chat-history" scroll-y scroll-into-view="{{chatScrollTarget}}">
      <view wx:if="{{!chatMessages.length}}" class="word-chat-welcome">
        <text>从一个问题开始</text>
        <view class="word-chat-prompts">
          <button wx:for="{{chatSuggestions}}" wx:key="*this" data-question="{{item}}" bindtap="askChatSuggestion" disabled="{{chatLoading}}">{{item}}</button>
        </view>
      </view>
      <view wx:for="{{chatMessages}}" wx:key="index" class="word-chat-message word-chat-message--{{item.role}}">
        <text class="word-chat-speaker">{{item.role === 'user' ? '你' : 'AI'}}</text>
        <text user-select>{{item.content}}</text>
      </view>
      <text wx:if="{{chatLoading}}" class="word-chat-pending">AI 正在整理学习建议…</text>
      <text wx:if="{{chatError}}" class="word-chat-error">{{chatError}}</text>
      <view id="chat-bottom"></view>
    </scroll-view>
    <view class="word-chat-compose">
      <textarea class="word-chat-input" value="{{chatInput}}" bindinput="handleChatInput" maxlength="{{chatMaxLength}}" placeholder="询问关于 {{chatWord.term}} 的问题…" auto-height="false" aria-label="输入关于 {{chatWord.term}} 的问题"></textarea>
      <button class="word-chat-send" bindtap="sendChatInput" disabled="{{!chatInput || chatLoading}}" loading="{{chatLoading}}" aria-label="发送问题">➤</button>
    </view>
    <text class="word-chat-count">{{chatInput.length}} / {{chatMaxLength}}</text>
  </view>
</view>
